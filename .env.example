# Public absolute origin used for social preview URLs.
OPENWOOD_PUBLIC_ORIGIN=http://localhost:3000

# Cloudflare deployment resources. Local development uses project-local emulation.
OPENWOOD_D1_DATABASE_NAME=openwood-studio
OPENWOOD_D1_DATABASE_ID=
OPENWOOD_R2_BUCKET_NAME=openwood-assets

# Anonymous-studio model safety budgets (rolling 24 hours).
OPENWOOD_MAX_RUNS_PER_DAY=24
OPENWOOD_MAX_DEPLOYMENT_RUNS_PER_DAY=250

# Changed/created audience signals allowed per storyworld in one anchored
# 60-second window. Idempotent repeats do not consume the budget.
OPENWOOD_AUDIENCE_SIGNALS_PER_PROJECT_MINUTE=600

# Optional global OpenAI-compatible fallback. Manual studio mode works without it.
# Ollama example: http://localhost:11434/v1
# vLLM example: http://localhost:8000/v1
OPENWOOD_LLM_BASE_URL=
OPENWOOD_LLM_MODEL=
OPENWOOD_LLM_API_KEY=

# Optional craft-specific routes. A complete lane overrides the global fallback
# only for its assigned stages. Secrets remain server-side.
#
# FreeToken is useful for private local text inference. Its current multimodal
# checkpoints are text-only, so this configuration advertises no media synthesis.
# OPENWOOD_STORY_LLM_PROVIDER=freetoken
# OPENWOOD_STORY_LLM_BASE_URL=http://127.0.0.1:1919/v1
# OPENWOOD_STORY_LLM_MODEL=your-pinned-model
# OPENWOOD_STORY_LLM_MODEL_REVISION=your-checkpoint-or-weight-digest
# OPENWOOD_STORY_LLM_JSON_MODE=prompt
# OPENWOOD_STORY_LLM_DATA_BOUNDARY=local
# OPENWOOD_STORY_LLM_MAX_OUTPUT_TOKENS=8192
# OPENWOOD_STORY_LLM_TIMEOUT_MS=90000
# OPENWOOD_STORY_LLM_MAX_CONCURRENCY=1
# OPENWOOD_STORY_LLM_API_KEY=
#
# OPENWOOD_PLANNING_LLM_PROVIDER=openai-compatible
# OPENWOOD_PLANNING_LLM_BASE_URL=
# OPENWOOD_PLANNING_LLM_MODEL=
# OPENWOOD_PLANNING_LLM_MODEL_REVISION=
# OPENWOOD_PLANNING_LLM_API_KEY=
#
# Use a different model family or independently operated endpoint for real
# critic independence. A persona alone is not an independent judge.
# OPENWOOD_CRITIC_LLM_PROVIDER=openai-compatible
# OPENWOOD_CRITIC_LLM_BASE_URL=
# OPENWOOD_CRITIC_LLM_MODEL=
# OPENWOOD_CRITIC_LLM_MODEL_REVISION=
# OPENWOOD_CRITIC_LLM_API_KEY=
