# Public absolute origin used for social preview URLs.
OPENWOOD_PUBLIC_ORIGIN=http://localhost:3000

# Cloudflare deployment resources. Local development uses project-local emulation.
OPENWOOD_D1_DATABASE_NAME=openwood-studio
OPENWOOD_D1_DATABASE_ID=
OPENWOOD_R2_BUCKET_NAME=openwood-assets

# Anonymous-studio model safety budgets (rolling 24 hours).
OPENWOOD_MAX_RUNS_PER_DAY=24
OPENWOOD_MAX_DEPLOYMENT_RUNS_PER_DAY=250

# Optional OpenAI-compatible model endpoint. Manual studio mode works without it.
# Ollama example: http://localhost:11434/v1
# vLLM example: http://localhost:8000/v1
OPENWOOD_LLM_BASE_URL=
OPENWOOD_LLM_MODEL=
OPENWOOD_LLM_API_KEY=
